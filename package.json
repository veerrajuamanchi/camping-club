{
  "name": "private-camping-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm --prefix frontend test",
    "test:db": "node scripts/test-db.mjs",
    "test:integration": "node scripts/test-phase1-integration.mjs",
    "test:phase2-integration": "node scripts/test-phase2-integration.mjs",
    "security:scan": "node scripts/scan-client-bundle.mjs",
    "verify": "npm run typecheck && npm test && npm run test:db && npm run test:integration && npm run test:phase2-integration && npm run build && npm run security:scan"
  },
  "devDependencies": {
    "supabase": "2.120.0"
  }
}
