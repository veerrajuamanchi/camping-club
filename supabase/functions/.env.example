# Store real values as Supabase Edge Function secrets. Do not commit a populated file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase injects SUPABASE_SECRET_KEYS as a JSON map in hosted Edge Functions.
# Do not store or commit a legacy service-role key here.
WEB_APP_URL=https://YOUR_RENDER_STATIC_SITE.onrender.com
ALLOWED_ORIGINS=https://YOUR_RENDER_STATIC_SITE.onrender.com
INVITATION_HMAC_KEY=GENERATE_32_RANDOM_BYTES_BASE64
EMAIL_HMAC_KEY_VERSION=v1
IDEMPOTENCY_HMAC_KEY=GENERATE_32_RANDOM_BYTES_BASE64
PAYMENT_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_BASE64
PAYMENT_ENCRYPTION_KEY_VERSION=v1
PAYMENT_FINGERPRINT_KEY=GENERATE_A_DIFFERENT_32_RANDOM_BYTES_BASE64
BOOTSTRAP_ADMIN_TOKEN=GENERATE_ONE_TIME_RANDOM_TOKEN
